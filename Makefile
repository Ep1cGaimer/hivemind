SHELL := /bin/sh

PYTHON ?= python3
NODE ?= node
HOST ?= 127.0.0.1
PORT ?= 8000
HIVEMIND_BACKEND ?= memory
TEST_ARGS ?= -v
FALKORDB_HOST ?= 127.0.0.1
FALKORDB_PORT ?= 6380
FALKORDB_GRAPH ?= hivemind_live_gateway
FALKORDB_USERNAME ?=
FALKORDB_PASSWORD ?=

.PHONY: test test-live check run mcp

test:
	@HIVEMIND_BACKEND=memory HIVEMIND_API_KEY= PYTHONDONTWRITEBYTECODE=1 PYTHONPATH="$(CURDIR)" "$(PYTHON)" -m unittest discover -s tests -p 'test_*.py' $(TEST_ARGS)

test-live:
	@HIVEMIND_LIVE_TESTS=1 FALKORDB_HOST="$(FALKORDB_HOST)" FALKORDB_PORT="$(FALKORDB_PORT)" FALKORDB_GRAPH="$(FALKORDB_GRAPH)" FALKORDB_USERNAME="$(FALKORDB_USERNAME)" FALKORDB_PASSWORD="$(FALKORDB_PASSWORD)" PYTHONDONTWRITEBYTECODE=1 PYTHONPATH="$(CURDIR)" "$(PYTHON)" -m unittest discover -s tests -p '*live.py' $(TEST_ARGS)

check:
	@PYTHONPYCACHEPREFIX="$${TMPDIR:-/tmp}/hivemind-pycache" PYTHONPATH="$(CURDIR)" "$(PYTHON)" -m compileall -q hivemind tests
	@"$(NODE)" --check web/app.js
	@$(MAKE) --no-print-directory test PYTHON="$(PYTHON)" TEST_ARGS="$(TEST_ARGS)"

run:
	@HIVEMIND_BACKEND="$(HIVEMIND_BACKEND)" FALKORDB_HOST="$(FALKORDB_HOST)" FALKORDB_PORT="$(FALKORDB_PORT)" FALKORDB_GRAPH="$(FALKORDB_GRAPH)" FALKORDB_USERNAME="$(FALKORDB_USERNAME)" FALKORDB_PASSWORD="$(FALKORDB_PASSWORD)" PYTHONPATH="$(CURDIR)" "$(PYTHON)" -m hivemind --host "$(HOST)" --port "$(PORT)"

mcp:
	@HIVEMIND_BACKEND="$(HIVEMIND_BACKEND)" FALKORDB_HOST="$(FALKORDB_HOST)" FALKORDB_PORT="$(FALKORDB_PORT)" FALKORDB_GRAPH="$(FALKORDB_GRAPH)" FALKORDB_USERNAME="$(FALKORDB_USERNAME)" FALKORDB_PASSWORD="$(FALKORDB_PASSWORD)" PYTHONPATH="$(CURDIR)" "$(PYTHON)" -m hivemind.mcp_server
