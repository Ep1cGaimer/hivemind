# Local defaults. HTTP and MCP entry points read these values from the process
# environment; they do not automatically load a .env file.
# Unset/blank and "memory" use the seeded offline fixture. "falkordb" enables
# the live profile only when the explicit FALKORDB_* connection settings below
# are present; it never silently falls back to memory.
HIVEMIND_BACKEND=memory
HIVEMIND_HOST=127.0.0.1
HIVEMIND_PORT=8000
# Optional: when set, mutating HTTP routes require X-HiveMind-Key.
HIVEMIND_API_KEY=

# Simple local workspace identity. Change this before sharing the server.
HIVEMIND_OPERATOR_PASSWORD=operator
# Leave blank for a random graph-persisted signing key, or configure a strong key.
HIVEMIND_AUTH_SECRET=
# Optional additional users: alice=passphrase,bob=passphrase
HIVEMIND_USERS=

# Live profile: the isolated local server documented in README uses this port.
# Keep the graph name project-specific; it selects only this HiveMind graph.
FALKORDB_SERVER_VERSION=6.0.2
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6380
FALKORDB_GRAPH=hivemind_live_gateway
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
